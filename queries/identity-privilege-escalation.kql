let AuthActivity =
    SecurityEvent
    | where EventID in (4624, 4625)
    | extend UserName = extract(@"([^\\]+)$", 1, Account)
    | where isnotempty(UserName)
    | summarize
        FailedLogons = countif(EventID == 4625),
        SuccessfulLogons = countif(EventID == 4624),
        FirstFailed = minif(TimeGenerated, EventID == 4625),
        LastFailed = maxif(TimeGenerated, EventID == 4625),
        SuccessTime = maxif(TimeGenerated, EventID == 4624),
        SuccessfulLogonSIDs = make_set_if(
            TargetUserSid,
            EventID == 4624
                and isnotempty(TargetUserSid)
                and TargetUserSid != "S-1-0-0"
        )
        by Computer, UserName
    | where FailedLogons >= 3
    | where SuccessfulLogons >= 1
    | where LastFailed < SuccessTime;

let PrivilegeChanges =
    SecurityEvent
    | where EventID == 4732
    | where TargetAccount has "Administrators"
    | where isnotempty(MemberSid)
    | project
        Computer,
        PrivilegeTime = TimeGenerated,
        MemberSid,
        TargetAccount,
        SubjectUserName;

AuthActivity
| join kind=inner PrivilegeChanges on Computer
| extend MatchingSID = set_intersect(
    SuccessfulLogonSIDs,
    pack_array(MemberSid)
)
| where array_length(MatchingSID) > 0
| where SuccessTime < PrivilegeTime
| project
    Computer,
    UserName,
    FailedLogons,
    SuccessfulLogons,
    FirstFailed,
    LastFailed,
    SuccessTime,
    PrivilegeTime,
    MemberSid,
    MatchingSID,
    TargetAccount,
    PrivilegeChangedBy = SubjectUserName
| order by PrivilegeTime desc
